<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true" hbarPolicy="NEVER" prefViewportWidth="520"
            prefViewportHeight="400" minWidth="0" minHeight="0"
            styleClass="help-scroll" accessibleText="How Koko works">
    <content>
        <VBox spacing="22" minWidth="0" styleClass="help-content">
            <VBox spacing="8" minWidth="0">
                <Label text="Cards and decks" styleClass="subsection-title" />
                <Label wrapText="true" minHeight="-Infinity"
                       text="Your library owns every card. A deck only points at cards, so one word can sit in several decks and still has a single shared progress." />
                <Label wrapText="true" minHeight="-Infinity"
                       text="Add and edit words under Global vocabulary. Select a deck, then use Add existing card to put a word into it." />
                <Label wrapText="true" minHeight="-Infinity"
                       text="Removing a card from a deck, or deleting a deck, keeps your words. Deleting a card under Global vocabulary removes it from every deck." />
            </VBox>
            <VBox spacing="10" minWidth="0">
                <Label text="Choose a review" styleClass="subsection-title" />
                <Label wrapText="true" minHeight="-Infinity"
                       text="Pick Flashcard or Typing for how you answer, then pick which cards:" />
                <VBox spacing="3" minWidth="0">
                    <Label text="Review due" styleClass="help-action" />
                    <Label wrapText="true" minHeight="-Infinity"
                           text="Cards in the selected deck that are due today or earlier, oldest first." />
                </VBox>
                <VBox spacing="3" minWidth="0">
                    <Label text="Review all" styleClass="help-action" />
                    <Label wrapText="true" minHeight="-Infinity"
                           text="Every card in the selected deck, in deck order, due or not." />
                </VBox>
                <VBox spacing="3" minWidth="0">
                    <Label text="Review selected" styleClass="help-action" />
                    <Label wrapText="true" minHeight="-Infinity"
                           text="One card chosen in Global vocabulary, due or not." />
                </VBox>
            </VBox>
            <VBox spacing="8" minWidth="0">
                <Label text="During a review" styleClass="subsection-title" />
                <Label wrapText="true" minHeight="-Infinity"
                       text="Flashcard: choose Reveal to see the Romaji and meaning, then mark Correct or Incorrect." />
                <Label wrapText="true" minHeight="-Infinity"
                       text="Typing: enter the exact Hiragana and choose Submit, or choose Skip. Both show feedback; choose Next to continue." />
                <Label wrapText="true" minHeight="-Infinity"
                       text="Stop ends the session and leaves unanswered cards unchanged. Then choose Back to Home." />
            </VBox>
            <VBox spacing="8" minWidth="0">
                <Label text="Progress and saving" styleClass="subsection-title" />
                <Label wrapText="true" minHeight="-Infinity"
                       text="Flashcard and Typing progress are separate, and each is shared across decks. A correct answer raises mastery up to 5 and pushes the next review out by 1, 3, 7, 14, then 30 days. Incorrect lowers mastery; incorrect and skipped cards return tomorrow." />
                <Label wrapText="true" minHeight="-Infinity"
                       text="Koko saves automatically after every change. If a save fails, nothing is recorded: fix the problem, then retry the same action or choose Stop." />
            </VBox>
            <VBox spacing="8" minWidth="0">
                <Label text="Transfer decks" styleClass="subsection-title" />
                <Label wrapText="true" minHeight="-Infinity"
                       text="Transfer imports or exports one deck as a JSON file holding words only, never learning progress. Import checks the whole file first, lets you confirm the deck name, and reuses words you already have along with their progress." />
            </VBox>
        </VBox>
    </content>
</ScrollPane>
