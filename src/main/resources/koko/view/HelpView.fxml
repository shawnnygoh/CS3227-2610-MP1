<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true" hbarPolicy="NEVER" prefViewportWidth="520"
            prefViewportHeight="400" minWidth="0" minHeight="0"
            styleClass="help-scroll" accessibleText="How Koko works">
    <content>
        <VBox spacing="22" minWidth="0" styleClass="help-content">
            <VBox spacing="8" minWidth="0">
                <Label text="Vocabulary and decks" styleClass="subsection-title" />
                <Label wrapText="true" minHeight="-Infinity"
                       text="Add and edit words in Global vocabulary. Select a deck to see its cards, then use Add existing card to add a word from your library." />
                <Label wrapText="true" minHeight="-Infinity"
                       text="A word can belong to several decks or none. You can rename decks. Removing a card from a deck, or deleting a deck, keeps the global cards. Deleting a global card removes it from every deck and asks for confirmation." />
            </VBox>
            <VBox spacing="10" minWidth="0">
                <Label text="Choose a review" styleClass="subsection-title" />
                <VBox spacing="3" minWidth="0">
                    <Label text="Review due" styleClass="help-action" />
                    <Label wrapText="true" minHeight="-Infinity"
                           text="Cards due today or earlier in the selected deck, oldest due first. Equal due dates follow deck order." />
                </VBox>
                <VBox spacing="3" minWidth="0">
                    <Label text="Review all" styleClass="help-action" />
                    <Label wrapText="true" minHeight="-Infinity"
                           text="Every card in the selected deck, once in deck order, including cards scheduled for later. Return Home to start another session anytime." />
                </VBox>
                <VBox spacing="3" minWidth="0">
                    <Label text="Review selected" styleClass="help-action" />
                    <Label wrapText="true" minHeight="-Infinity"
                           text="One selected global card, even if it is not due or does not belong to a deck." />
                </VBox>
            </VBox>
            <VBox spacing="8" minWidth="0">
                <Label text="During a review" styleClass="subsection-title" />
                <Label wrapText="true" minHeight="-Infinity"
                       text="Read the Hiragana, then choose Reveal to see Romaji and English meaning. Only then choose Correct or Incorrect. Incorrect cards are not repeated in the same session." />
                <Label wrapText="true" minHeight="-Infinity"
                       text="Stop leaves unanswered cards unchanged. After stopping or finishing, choose Back to Home." />
            </VBox>
            <VBox spacing="8" minWidth="0">
                <Label text="Progress and saving" styleClass="subsection-title" />
                <Label wrapText="true" minHeight="-Infinity"
                       text="Flashcard progress is shared across decks. Every recorded answer, including an early review, updates mastery, counts, and scheduling from the date you answer. Typing progress stays unchanged." />
                <Label wrapText="true" minHeight="-Infinity"
                       text="Koko saves each outcome automatically. If saving fails, no progress is recorded: retry Correct or Incorrect, or choose Stop." />
            </VBox>
        </VBox>
    </content>
</ScrollPane>
